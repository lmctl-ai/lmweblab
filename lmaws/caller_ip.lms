# Detect the caller's public IPv4 through lmcurl, never through curl/aws CLI.
mkdir(".lmweblab-local");
let p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let s = curl.session("https://checkip.amazonaws.com");
let r = s.get("/").proxy("").retry(3,1000).timeout(10000).send();
assert_eq(r.status(), 200);
file_write(".lmweblab-local/caller-ip.txt", str_trim(r.body()) + "\n");
end _dsl_
savedsl(p, ".lmweblab-local/caller-ip.dslb");
let result = system(concat(dsl_cli(p), ["--dsl", ".lmweblab-local/caller-ip.dslb"]), 30000);
if (result.code != 0) { println(result.stderr); assert(false, "caller IP detection failed"); }
let ip = trim(read_file(".lmweblab-local/caller-ip.txt"));
assert(regex_test(ip, "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"), "caller IP response was not IPv4");
