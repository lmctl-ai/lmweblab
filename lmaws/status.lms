# Read-only status and account-wide search for this run's lmaws resources.
import "./common.lms";
let o = options(ARGV);
configure_live(o);
let p = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud = aws.example("web_stack_status");
check(cloud.is_demo() == ${!o.live});
let web = cloud.web_stack(${o.run_id}, ${o.domain}, ".lmweblab-local/lmaws-web-state-" + ${o.run_id} + ".json");
let rows = web.status();
rows.csv(".lmweblab-local/lmaws-status.csv");
end _dsl_
savedsl(p, ".lmweblab-local/lmaws-status.dslb");
let r = system(concat(dsl_cli(p), concat(o.live ? ["--live","--profile","lmaws","--region","us-east-1"] : ["--dry-run"], ["--dsl", ".lmweblab-local/lmaws-status.dslb"])), 300000);
println(r.stdout); if (r.code != 0) { println(r.stderr); assert(false, "web stack status failed"); }
