# lmweblab Part B (lmcloud): Tear down the web stack (down) and prove zero leftovers with lmaws
# 1. Runs tofu.destroy(dir) via lmcloud and verifies tofu.state_list(dir) is empty.
# 2. Independently audits S3 buckets, EC2 instances, and EC2 security groups via lmaws
#    to prove zero leftovers matching lmaws-tf-<run_id> or tag lmaws_test=<run_id>.

fn env_or(key, fallback) {
  let v = getenv(key, "");
  if (v == "") { return fallback; }
  return v;
}

live = env_or("LMWEBLAB_LIVE", "0") == "1";
enable_acm = env_or("LMWEBLAB_ACM", "0") == "1";
run_id = env_or("LMWEBLAB_RUN_ID", "");
domain = env_or("LMWEBLAB_DOMAIN", "example.com");
profile = env_or("AWS_PROFILE", "lmaws");

let i = 0;
while (i < len(ARGV)) {
  let a = ARGV[i];
  if (a == "--live") {
    live = true;
  } else if (a == "--offline" || a == "--dry-run") {
    live = false;
  } else if (a == "--acm" || a == "--phase2") {
    enable_acm = true;
  } else if (a == "--run-id" && i + 1 < len(ARGV)) {
    i = i + 1;
    run_id = ARGV[i];
  } else if (a == "--domain" && i + 1 < len(ARGV)) {
    i = i + 1;
    domain = ARGV[i];
  } else if (!starts_with(a, "--") && run_id == "") {
    run_id = a;
  }
  i = i + 1;
}

mkdir(".lmweblab-local");
stack_dir = file_exists("lmcloud/main.tf") ? "lmcloud" : ".";

if (file_exists(".lmweblab-local/lmcloud-stack.json")) {
  meta = json_parse(read_file(".lmweblab-local/lmcloud-stack.json"));
  if (run_id == "") { run_id = get(meta, "run_id", ""); }
  if (domain == "example.com") { domain = get(meta, "domain", "example.com"); }
  if (get(meta, "mode", "offline") == "live") { live = true; }
  if (str(get(meta, "enable_acm", "false")) == "true") { enable_acm = true; }
}
if (run_id == "" && file_exists(".lmweblab-local/lmcloud-run-id.txt")) {
  run_id = trim(read_file(".lmweblab-local/lmcloud-run-id.txt"));
}
if (run_id == "") {
  run_id = "demo01";
}
assert(regex_test(run_id, "^[a-z0-9]{4,16}$"), "run_id must be 4-16 lowercase alphanumeric chars");

if (live) {
  assert(profile == "lmaws", "Live teardown MUST use AWS_PROFILE=lmaws only (never admin)");
  set_env("AWS_PROFILE", "lmaws");
  set_env("AWS_DEFAULT_PROFILE", "lmaws");
  set_env("AWS_REGION", "us-east-1");
  set_env("AWS_DEFAULT_REGION", "us-east-1");
} else {
  set_env("AWS_EC2_METADATA_DISABLED", "true");
}

t0 = now();
offline_str = live ? "false" : "true";
acm_str = enable_acm ? "true" : "false";
profile_str = live ? "lmaws" : "";

# Step 1: OpenTofu destroy via lmcloud + empty state verification
destroy_prog = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
let dir = ${stack_dir};
let run_id = ${run_id};
let domain = ${domain};
let offline_mode = ${offline_str};
let enable_acm = ${acm_str};
let aws_profile = ${profile_str};

let ok_init = tofu.init(dir);
if (!ok_init) {
  print("INIT_ERROR: " + tofu.last_error());
  assert_close(0.0, 1.0, 0.0);
}

tofu.var("run_id", run_id);
tofu.var("domain", domain);
tofu.var("aws_region", "us-east-1");
tofu.var("aws_profile", aws_profile);
tofu.var("offline_mode", offline_mode);
tofu.var("enable_acm", enable_acm);

if (offline_mode == "false") {
  let ok_destroy = tofu.destroy(dir);
  if (!ok_destroy) {
    print("DESTROY_ERROR: " + tofu.last_error());
    assert_close(0.0, 1.0, 0.0);
  }
}

let remaining = str_trim(tofu.state_list(dir));
if (str_len(remaining) != 0) {
  print("LEFTOVER_STATE_ERROR: " + remaining);
  assert_close(float(str_len(remaining)), 0.0, 0.0);
}
let post_plan = tofu.plan(dir);
let expected_adds = 14;
if (enable_acm == "true") {
  expected_adds = 17;
}
assert_close(float(post_plan.add()), float(expected_adds), 0.0);
print("TOFU_STATE_EMPTY_OK: 0 resources in state for run_id=" + run_id + " (post-destroy plan add=" + str(post_plan.add()) + ")");
end _dsl_

t_destroy0 = now();
destroy_dslb = ".lmweblab-local/lmcloud-down.dslb";
savedsl(destroy_prog, destroy_dslb);
r_destroy = system(concat(dsl_cli(destroy_prog), ["--lmcode", destroy_dslb]), 1500000);
destroy_ms = now() - t_destroy0;
println(r_destroy.stdout);
if (r_destroy.code != 0) {
  println(r_destroy.stderr);
}
assert(r_destroy.code == 0, "lmcloud destroy failed");

# Step 2: Independent leftover verification via lmaws
t_audit0 = now();
audit_prog = _dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let is_live = ${offline_str} == "false";
if (is_live) {
  let cloud_live = aws.region("us-east-1");
  file_write(".lmweblab-local/audit-buckets.json", cloud_live.buckets().json());
  file_write(".lmweblab-local/audit-instances.json", cloud_live.instances().json());
  file_write(".lmweblab-local/audit-sgs.json", cloud_live.security_groups().json());
} else {
  let cloud_demo = aws.demo();
  file_write(".lmweblab-local/audit-buckets.json", cloud_demo.buckets().json());
  file_write(".lmweblab-local/audit-instances.json", cloud_demo.instances().json());
  file_write(".lmweblab-local/audit-sgs.json", cloud_demo.security_groups().json());
}
end _dsl_

audit_dslb = ".lmweblab-local/lmcloud-audit.dslb";
savedsl(audit_prog, audit_dslb);
set_env("LMAWS_LIVE", live ? "1" : "0");
set_env("LMAWS_MAX_COST_USD", "0.05");
r_audit = system(concat(dsl_cli(audit_prog), ["--lmcode", audit_dslb]), 120000);
if (r_audit.code != 0) {
  println(r_audit.stderr);
}
assert(r_audit.code == 0, "lmaws leftover audit failed");

buckets_list = json_parse(read_file(".lmweblab-local/audit-buckets.json"));
instances_list = json_parse(read_file(".lmweblab-local/audit-instances.json"));
sgs_list = json_parse(read_file(".lmweblab-local/audit-sgs.json"));

target_bucket = "lmaws-tf-" + run_id;
target_sg = "lmaws-tf-sg-" + run_id;
leftovers = [];

for (b in buckets_list) {
  b_str = json_stringify(b);
  if (contains(b_str, target_bucket) || contains(b_str, run_id)) {
    push(leftovers, "bucket:" + b_str);
  }
}

for (inst in instances_list) {
  i_str = json_stringify(inst);
  state_val = str(get(inst, "state", ""));
  if (state_val != "terminated" && (contains(i_str, "lmaws-tf-app-" + run_id) || contains(i_str, run_id))) {
    push(leftovers, "instance:" + i_str);
  }
}

for (sg in sgs_list) {
  sg_str = json_stringify(sg);
  if (contains(sg_str, target_sg) || contains(sg_str, run_id)) {
    push(leftovers, "security_group:" + sg_str);
  }
}

assert(len(leftovers) == 0, "Leftover AWS resources found for run_id=" + run_id + ": " + json_stringify(leftovers));
audit_ms = now() - t_audit0;

elapsed_ms = now() - t0;
write_file(".lmweblab-local/lmcloud-down-timing.json", json_stringify({
  phase: "down",
  mode: live ? "live" : "offline",
  enable_acm: enable_acm,
  run_id: run_id,
  destroy_ms: destroy_ms,
  audit_ms: audit_ms,
  elapsed_ms: elapsed_ms,
  leftovers_count: len(leftovers)
}, 2));

println("ok - lmcloud/down.lms verified 0 leftovers for run_id=" + run_id + " (" + str(elapsed_ms) + " ms)");
println("estimated cost: $0.0000");
