# lmweblab Part B (lmcloud): Provision the web stack (up)
# Offline mode (default): runs tofu.fmt_check, tofu.init, tofu.validate, and offline tofu.plan.
# Live mode (--live or LMWEBLAB_LIVE=1): detects caller /32 IP via lmcurl, runs tofu.init/plan/apply
# with AWS_PROFILE=lmaws, and writes local stack metadata to .lmweblab-local/lmcloud-stack.json.

fn env_or(key, fallback) {
  let v = getenv(key, "");
  if (v == "") { return fallback; }
  return v;
}

fn parse_cli_args(argv) {
  let opts = {
    live: env_or("LMWEBLAB_LIVE", "0") == "1",
    enable_acm: env_or("LMWEBLAB_ACM", "0") == "1",
    run_id: env_or("LMWEBLAB_RUN_ID", ""),
    domain: env_or("LMWEBLAB_DOMAIN", "example.com"),
    profile: env_or("AWS_PROFILE", "lmaws"),
    region: env_or("AWS_REGION", "us-east-1"),
    instance_type: env_or("LMWEBLAB_INSTANCE_TYPE", "t4g.nano"),
    caller_cidr: env_or("LMWEBLAB_CALLER_CIDR", "")
  };
  let i = 0;
  while (i < len(argv)) {
    let a = argv[i];
    if (a == "--live") {
      opts.live = true;
    } else if (a == "--offline" || a == "--dry-run") {
      opts.live = false;
    } else if (a == "--acm" || a == "--phase2") {
      opts.enable_acm = true;
    } else if (a == "--run-id" && i + 1 < len(argv)) {
      i = i + 1;
      opts.run_id = argv[i];
    } else if (a == "--domain" && i + 1 < len(argv)) {
      i = i + 1;
      opts.domain = argv[i];
    } else if (a == "--instance-type" && i + 1 < len(argv)) {
      i = i + 1;
      opts.instance_type = argv[i];
    } else if (a == "--caller-cidr" && i + 1 < len(argv)) {
      i = i + 1;
      opts.caller_cidr = argv[i];
    }
    i = i + 1;
  }
  return opts;
}

opts = parse_cli_args(ARGV);
stack_dir = file_exists("lmcloud/main.tf") ? "lmcloud" : ".";
mkdir(".lmweblab-local");

# Enforce safety guards
assert(opts.region == "us-east-1", "region must be us-east-1");
assert(opts.instance_type == "t4g.nano" || opts.instance_type == "t3.nano", "instance_type must be t4g.nano or t3.nano");
if (opts.live) {
  assert(opts.profile == "lmaws", "Live runs MUST use AWS_PROFILE=lmaws only (never admin)");
  assert(opts.domain != "" && opts.domain != "example.com", "Live runs require LMWEBLAB_DOMAIN");
}

if (opts.run_id == "") {
  if (file_exists(".lmweblab-local/lmcloud-run-id.txt")) {
    opts.run_id = trim(read_file(".lmweblab-local/lmcloud-run-id.txt"));
  }
  if (opts.run_id == "") {
    if (opts.live) {
      t_str = str(now());
      opts.run_id = "r" + substring(t_str, len(t_str) - 5, len(t_str));
    } else {
      opts.run_id = "demo01";
    }
  }
}
assert(regex_test(opts.run_id, "^[a-z0-9]{4,16}$"), "run_id must be 4-16 lowercase alphanumeric chars");
write_file(".lmweblab-local/lmcloud-run-id.txt", opts.run_id + "\n");

# Ensure static site banner exists
if (!file_exists(path_join(stack_dir, "../shared/site/banner.png")) && file_exists("shared/site/render_banner.lms")) {
  r_banner = system lmctl shared/site/render_banner.lms;
  assert(r_banner.code == 0);
}

# Detect caller public IPv4 /32 via lmcurl when live (or use RFC 5737 test-net in offline mode)
if (opts.caller_cidr == "") {
  if (opts.live) {
    ip_prog = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let s = curl.session("https://checkip.amazonaws.com");
let resp = s.get("/").timeout(10000).retry(3, 1000).send();
assert_eq(resp.status(), 200);
let ip = str_trim(resp.body());
file_write(".lmweblab-local/caller-ip.txt", ip);
end _dsl_
    ip_dslb = ".lmweblab-local/detect-ip.dslb";
    savedsl(ip_prog, ip_dslb);
    r_ip = system(concat(dsl_cli(ip_prog), ["--dsl", ip_dslb]), 30000);
    assert(r_ip.code == 0, "Failed to detect caller public IP via checkip.amazonaws.com: " + r_ip.stderr);
    detected_ip = trim(read_file(".lmweblab-local/caller-ip.txt"));
    assert(regex_test(detected_ip, "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"), "Invalid IPv4 from checkip: " + detected_ip);
    opts.caller_cidr = detected_ip + "/32";
  } else {
    opts.caller_cidr = "203.0.113.10/32";
  }
}
assert(ends_with(opts.caller_cidr, "/32") && opts.caller_cidr != "0.0.0.0/32", "caller_cidr must be a non-zero /32 CIDR");

t0 = now();
offline_str = opts.live ? "false" : "true";
acm_str = opts.enable_acm ? "true" : "false";
profile_str = opts.live ? "lmaws" : "";

if (opts.live) {
  set_env("AWS_PROFILE", "lmaws");
  set_env("AWS_DEFAULT_PROFILE", "lmaws");
  set_env("AWS_REGION", "us-east-1");
  set_env("AWS_DEFAULT_REGION", "us-east-1");
} else {
  set_env("AWS_EC2_METADATA_DISABLED", "true");
}

up_prog = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
let dir = ${stack_dir};
let run_id = ${opts.run_id};
let domain = ${opts.domain};
let caller_cidr = ${opts.caller_cidr};
let instance_type = ${opts.instance_type};
let offline_mode = ${offline_str};
let enable_acm = ${acm_str};
let aws_profile = ${profile_str};

if (!tofu.fmt_check(dir)) {
  print("FMT_ERROR: " + tofu.last_error());
  assert_close(0.0, 1.0, 0.0);
}

let ok_init = tofu.init(dir);
if (!ok_init) {
  print("INIT_ERROR: " + tofu.last_error());
  assert_close(0.0, 1.0, 0.0);
}

let ok_val = tofu.validate(dir);
if (!ok_val) {
  print("VALIDATE_ERROR: " + tofu.last_error());
  assert_close(0.0, 1.0, 0.0);
}

tofu.var("run_id", run_id);
tofu.var("domain", domain);
tofu.var("aws_region", "us-east-1");
tofu.var("aws_profile", aws_profile);
tofu.var("caller_cidr", caller_cidr);
tofu.var("instance_type", instance_type);
tofu.var("offline_mode", offline_mode);
tofu.var("enable_acm", enable_acm);

let p = tofu.plan(dir);
if (p.add() <= 0 && offline_mode == "true") {
  print("PLAN_ERROR: " + tofu.last_error());
  assert_close(0.0, 1.0, 0.0);
}
print("PLAN_SUMMARY: " + p.summary());

if (offline_mode == "false") {
  let ok_apply = tofu.apply(dir);
  if (!ok_apply) {
    print("APPLY_ERROR: " + tofu.last_error());
    let _ = tofu.destroy(dir);
    assert_close(0.0, 1.0, 0.0);
  }
  let meta_json = "{\n" +
    "  \"mode\": \"live\",\n" +
    "  \"run_id\": \"" + tofu.output(dir, "run_id") + "\",\n" +
    "  \"domain\": \"" + tofu.output(dir, "domain") + "\",\n" +
    "  \"bucket_name\": \"" + tofu.output(dir, "bucket_name") + "\",\n" +
    "  \"oac_id\": \"" + tofu.output(dir, "oac_id") + "\",\n" +
    "  \"distribution_id\": \"" + tofu.output(dir, "distribution_id") + "\",\n" +
    "  \"distribution_domain_name\": \"" + tofu.output(dir, "distribution_domain_name") + "\",\n" +
    "  \"cloudfront_http_url\": \"" + tofu.output(dir, "cloudfront_http_url") + "\",\n" +
    "  \"cloudfront_https_url\": \"" + tofu.output(dir, "cloudfront_https_url") + "\",\n" +
    "  \"site_fqdn\": \"" + tofu.output(dir, "site_fqdn") + "\",\n" +
    "  \"site_url\": \"" + tofu.output(dir, "site_url") + "\",\n" +
    "  \"app_fqdn\": \"" + tofu.output(dir, "app_fqdn") + "\",\n" +
    "  \"app_url\": \"" + tofu.output(dir, "app_url") + "\",\n" +
    "  \"instance_id\": \"" + tofu.output(dir, "instance_id") + "\",\n" +
    "  \"instance_public_ip\": \"" + tofu.output(dir, "instance_public_ip") + "\",\n" +
    "  \"security_group_id\": \"" + tofu.output(dir, "security_group_id") + "\"\n" +
    "}\n";
  file_write(".lmweblab-local/lmcloud-stack.json", meta_json);
} else {
  let meta_json = "{\n" +
    "  \"mode\": \"offline\",\n" +
    "  \"run_id\": \"" + run_id + "\",\n" +
    "  \"domain\": \"" + domain + "\",\n" +
    "  \"bucket_name\": \"lmaws-tf-" + run_id + "\",\n" +
    "  \"site_fqdn\": \"lmaws-tf-site-" + run_id + "." + domain + "\",\n" +
    "  \"site_url\": \"http://lmaws-tf-site-" + run_id + "." + domain + "\",\n" +
    "  \"app_fqdn\": \"lmaws-tf-app-" + run_id + "." + domain + "\",\n" +
    "  \"app_url\": \"http://lmaws-tf-app-" + run_id + "." + domain + "\",\n" +
    "  \"planned_add\": " + str(p.add()) + "\n" +
    "}\n";
  file_write(".lmweblab-local/lmcloud-stack.json", meta_json);
}
end _dsl_

up_dslb = ".lmweblab-local/lmcloud-up.dslb";
savedsl(up_prog, up_dslb);
r_up = system(concat(dsl_cli(up_prog), ["--dsl", up_dslb]), 1800000);
elapsed_ms = now() - t0;
println(r_up.stdout);
if (r_up.code != 0) {
  println(r_up.stderr);
}
assert(r_up.code == 0, "lmcloud up failed");

write_file(".lmweblab-local/lmcloud-up-timing.json", json_stringify({
  phase: "up",
  mode: opts.live ? "live" : "offline",
  run_id: opts.run_id,
  elapsed_ms: elapsed_ms
}, 2));

if (opts.live) {
  println("estimated cost: $0.0040 (spot nano + 8 GiB gp3 + public IPv4 + S3/CloudFront/Route53 requests)");
} else {
  println("estimated cost: $0.0000");
}
