# === CONFIG ===
let SCENARIO_NAME = "01-static-site-s3-cloudfront";
let ENGINE_NAME = "lmcloud";
let LIVE_MODE = getenv("LMWEBLAB_LIVE", "0") == "1";
# === END CONFIG ===

let base_dir = file_exists("up.lms") ? "." : "scenarios/01-static-site-s3-cloudfront/lmcloud";
let t0 = now();

println("=== [1/3] " + SCENARIO_NAME + " (" + ENGINE_NAME + ") up.lms ===");
let r_up = system(concat(["lmctl", path_join(base_dir, "up.lms")], ARGV), 1500000);
println(r_up.stdout);
if (r_up.code != 0) {
  println(r_up.stderr);
  let _ = system(concat(["lmctl", path_join(base_dir, "down.lms")], ARGV), 1500000);
  assert(false, "up.lms failed");
}

println("=== [2/3] " + SCENARIO_NAME + " (" + ENGINE_NAME + ") test.lms ===");
let r_test = system(concat(["lmctl", path_join(base_dir, "test.lms")], ARGV), 300000);
println(r_test.stdout);
if (r_test.code != 0) {
  println(r_test.stderr);
  let _ = system(concat(["lmctl", path_join(base_dir, "down.lms")], ARGV), 1500000);
  assert(false, "test.lms failed (stack torn down)");
}

println("=== [3/3] " + SCENARIO_NAME + " (" + ENGINE_NAME + ") down.lms ===");
let r_down = system(concat(["lmctl", path_join(base_dir, "down.lms")], ARGV), 1500000);
println(r_down.stdout);
if (r_down.code != 0) { println(r_down.stderr); }
assert(r_down.code == 0, "down.lms failed");

println("=== " + SCENARIO_NAME + " (" + ENGINE_NAME + ") completed in " + str(now() - t0) + " ms ===");
println("estimated cost: " + (LIVE_MODE ? "$0.0005" : "$0.0000"));
