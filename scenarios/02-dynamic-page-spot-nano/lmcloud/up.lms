# === CONFIG ===
let REGION = getenv("AWS_REGION", "") != "" ? getenv("AWS_REGION", "") : "us-east-1";
let DOMAIN = getenv("LMWEBLAB_DOMAIN", "") != "" ? getenv("LMWEBLAB_DOMAIN", "") : "example.com";
let NAME_PREFIX = "lmaws";
let SCENARIO_SLUG = "s02";
let AWS_PROFILE_NAME = getenv("AWS_PROFILE", "") != "" ? getenv("AWS_PROFILE", "") : "lmaws";
let INSTANCE_TYPE = "t4g.nano";
let VOLUME_SIZE_GB = 8;
let VOLUME_TYPE = "gp3";
let HTTP_PORT = 80;
let DNS_TTL = 60;
let OFFLINE_CALLER_CIDR = "203.0.113.10/32";
let LIVE_MODE = getenv("LMWEBLAB_LIVE", "0") == "1";
let DEFAULT_RUN_ID = getenv("LMWEBLAB_RUN_ID", "") != "" ? getenv("LMWEBLAB_RUN_ID", "") : "demo01";
let APPLY_TIMEOUT_MS = 600000;
# === END CONFIG ===

let live = LIVE_MODE;
let run_id = DEFAULT_RUN_ID;
let domain = DOMAIN;
let caller_cidr = getenv("LMWEBLAB_CALLER_CIDR", "");

let i = 0;
while (i < len(ARGV)) {
  let a = ARGV[i];
  if (a == "--live") { live = true; }
  else if (a == "--offline" || a == "--dry-run") { live = false; }
  else if (a == "--run-id" && i + 1 < len(ARGV)) { i = i + 1; run_id = ARGV[i]; }
  else if (a == "--domain" && i + 1 < len(ARGV)) { i = i + 1; domain = ARGV[i]; }
  else if (a == "--caller-cidr" && i + 1 < len(ARGV)) { i = i + 1; caller_cidr = ARGV[i]; }
  i = i + 1;
}

let stack_dir = file_exists("main.tf") ? "." : "scenarios/02-dynamic-page-spot-nano/lmcloud";
let state_dir = path_join(stack_dir, ".lmweblab-local");
mkdir(state_dir);

assert(REGION == "us-east-1", "REGION must be us-east-1");
assert(INSTANCE_TYPE == "t4g.nano" || INSTANCE_TYPE == "t3.nano", "INSTANCE_TYPE must be t4g.nano or t3.nano");
if (live) {
  assert(AWS_PROFILE_NAME == "lmaws", "Live runs MUST use AWS_PROFILE=lmaws only");
  assert(domain != "" && domain != "example.com", "Live runs require LMWEBLAB_DOMAIN");
  set_env("AWS_PROFILE", AWS_PROFILE_NAME);
  set_env("AWS_DEFAULT_PROFILE", AWS_PROFILE_NAME);
  set_env("AWS_REGION", REGION);
  set_env("AWS_DEFAULT_REGION", REGION);
} else {
  set_env("AWS_EC2_METADATA_DISABLED", "true");
}

assert(regex_test(run_id, "^[a-z0-9]{4,16}$"), "run_id must be 4-16 lowercase alphanumeric chars");
write_file(path_join(state_dir, "run-id.txt"), run_id + "\n");

if (caller_cidr == "") {
  if (live) {
    let ip_file = path_join(state_dir, "caller-ip.txt");
    let ip_prog = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let s = curl.session("https://checkip.amazonaws.com");
let resp = s.get("/").timeout(10000).retry(3, 1000).send();
assert_eq(resp.status(), 200);
file_write(${ip_file}, str_trim(resp.body()));
end _dsl_
    let ip_dslb = path_join(state_dir, "detect-ip.dslb");
    savedsl(ip_prog, ip_dslb);
    let r_ip = system(concat(dsl_cli(ip_prog), ["--dsl", ip_dslb]), 30000);
    assert(r_ip.code == 0, "Failed to detect caller public IP: " + r_ip.stderr);
    caller_cidr = trim(read_file(ip_file)) + "/32";
  } else {
    caller_cidr = OFFLINE_CALLER_CIDR;
  }
}
assert(ends_with(caller_cidr, "/32") && caller_cidr != "0.0.0.0/32", "caller_cidr must be a non-zero /32");

let offline_str = live ? "false" : "true";
let profile_str = live ? AWS_PROFILE_NAME : "";
let vol_size_str = str(VOLUME_SIZE_GB);
let port_str = str(HTTP_PORT);
let ttl_str = str(DNS_TTL);
let meta_path = path_join(state_dir, "stack.json");
let t0 = now();

let up_prog = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
let dir = ${stack_dir};
let run_id = ${run_id};
let name_prefix = ${NAME_PREFIX};
let scenario_slug = ${SCENARIO_SLUG};
let domain = ${domain};
let region = ${REGION};
let aws_profile = ${profile_str};
let offline_mode = ${offline_str};
let caller_cidr = ${caller_cidr};
let instance_type = ${INSTANCE_TYPE};
let vol_size = ${vol_size_str};
let vol_type = ${VOLUME_TYPE};
let http_port = ${port_str};
let dns_ttl = ${ttl_str};
let out_meta = ${meta_path};

if (!tofu.fmt_check(dir)) {
  print("FMT_ERROR: " + tofu.last_error());
  assert_close(0.0, 1.0, 0.0);
}
if (!tofu.init(dir)) {
  print("INIT_ERROR: " + tofu.last_error());
  assert_close(0.0, 1.0, 0.0);
}
if (!tofu.validate(dir)) {
  print("VALIDATE_ERROR: " + tofu.last_error());
  assert_close(0.0, 1.0, 0.0);
}

tofu.var("run_id", run_id);
tofu.var("name_prefix", name_prefix);
tofu.var("scenario_slug", scenario_slug);
tofu.var("domain", domain);
tofu.var("aws_region", region);
tofu.var("aws_profile", aws_profile);
tofu.var("offline_mode", offline_mode);
tofu.var("caller_cidr", caller_cidr);
tofu.var("instance_type", instance_type);
tofu.var("volume_size_gb", vol_size);
tofu.var("volume_type", vol_type);
tofu.var("http_port", http_port);
tofu.var("dns_ttl", dns_ttl);

let p = tofu.plan(dir);
if (p.add() <= 0 && offline_mode == "true") {
  print("PLAN_ERROR: " + tofu.last_error());
  assert_close(0.0, 1.0, 0.0);
}
print("PLAN_SUMMARY: " + p.summary());

if (offline_mode == "false") {
  if (!tofu.apply(dir)) {
    print("APPLY_ERROR: " + tofu.last_error());
    let _ = tofu.destroy(dir);
    assert_close(0.0, 1.0, 0.0);
  }
  let meta_json = "{\n" +
    "  \"mode\": \"live\",\n" +
    "  \"run_id\": \"" + tofu.output(dir, "run_id") + "\",\n" +
    "  \"domain\": \"" + tofu.output(dir, "domain") + "\",\n" +
    "  \"app_fqdn\": \"" + tofu.output(dir, "app_fqdn") + "\",\n" +
    "  \"app_url\": \"" + tofu.output(dir, "app_url") + "\",\n" +
    "  \"instance_id\": \"" + tofu.output(dir, "instance_id") + "\",\n" +
    "  \"instance_public_ip\": \"" + tofu.output(dir, "instance_public_ip") + "\",\n" +
    "  \"security_group_id\": \"" + tofu.output(dir, "security_group_id") + "\"\n" +
    "}\n";
  file_write(out_meta, meta_json);
} else {
  let app_fqdn = name_prefix + "-tf-" + scenario_slug + "-app-" + run_id + "." + domain;
  let meta_json = "{\n" +
    "  \"mode\": \"offline\",\n" +
    "  \"run_id\": \"" + run_id + "\",\n" +
    "  \"domain\": \"" + domain + "\",\n" +
    "  \"app_fqdn\": \"" + app_fqdn + "\",\n" +
    "  \"app_url\": \"http://" + app_fqdn + "\",\n" +
    "  \"instance_public_ip\": \"127.0.0.1\",\n" +
    "  \"planned_add\": " + str(p.add()) + "\n" +
    "}\n";
  file_write(out_meta, meta_json);
}
end _dsl_

let up_dslb = path_join(state_dir, "up.dslb");
savedsl(up_prog, up_dslb);
let r_up = system(concat(dsl_cli(up_prog), ["--dsl", up_dslb]), APPLY_TIMEOUT_MS);
println(r_up.stdout);
if (r_up.code != 0) { println(r_up.stderr); }
assert(r_up.code == 0, "scenario 02 up.lms failed");

let elapsed_ms = now() - t0;
println("ok - scenario 02 up.lms completed in " + str(elapsed_ms) + " ms");
println("estimated cost: " + (live ? "$0.0035" : "$0.0000"));
