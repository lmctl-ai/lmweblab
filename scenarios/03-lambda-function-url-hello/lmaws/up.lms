# === CONFIG ===
let REGION = "us-east-1";
let DOMAIN = getenv("LMWEBLAB_DOMAIN", "example.com");
let NAME_PREFIX = "lmaws";
let RUNTIME = "python3.12";
let MEMORY_MB = 128;
let TIMEOUT_S = 10;
let ROLE = "lmaws_lambda_exec";
let HANDLER = "handler.handler";
let SOURCE_FILE = "assets/handler.py";
let TTL_SECONDS = 3600;
let TTL_ATTRIBUTE = "expires_at";
let SCHEDULE = "rate(1 minute)";
let SITE_DIR = "../../../shared/site";
# === END CONFIG ===
assert(!contains(ARGV,"--live")&&getenv("LMWEBLAB_LIVE","0")!="1", "live Lambda rollout awaits the Lead and execution-role grant");
assert(REGION=="us-east-1"&&NAME_PREFIX=="lmaws", "scenario profile scope is lmaws / us-east-1");
let run_id=getenv("LMWEBLAB_RUN_ID","cafe03");assert(regex_test(run_id,"^[0-9a-f]{4,24}$"),"run id must be 4..24 hexadecimal digits");
mkdir(".lmweblab-local");
write_file(".lmweblab-local/state.json",json_stringify({run_id:run_id}));
let serverless_path=".lmweblab-local/serverless-"+run_id+".json";
let web_path=".lmweblab-local/web-"+run_id+".json";
let lambda_args=json_stringify({runtime:RUNTIME,handler:HANDLER,source_file:SOURCE_FILE,role:ROLE,memory_mb:MEMORY_MB,timeout_s:TIMEOUT_S,ttl_seconds:TTL_SECONDS,url_reason:"ephemeral public scenario API: no secrets, bounded tests, explicit teardown"});
let table_args=json_stringify({ttl_attribute:TTL_ATTRIBUTE});
let site_args=json_stringify({site_dir:SITE_DIR});
let event_args=json_stringify({schedule:SCHEDULE});
let program=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud=aws.region(${REGION}).demo();
let serverless=cloud.serverless_stack(${run_id},${DOMAIN},${serverless_path});
let lambda=serverless.step("lambda",${lambda_args});
let web=cloud.web_stack(${run_id},${DOMAIN},${web_path});
let certificate=web.step("certificate","{}");
let endpoint=serverless.status().get("lambda_url");let name=serverless.status().get("lambda_name");
let distribution=web.step("lambda_distribution","{\"function_name\":\""+name+"\",\"lambda_url\":\""+endpoint+"\",\"mixed\":false}");
let dns=web.step("dns_site","{}");
file_write(".lmweblab-local/state.json",serverless.status().json());
file_write(".lmweblab-local/up.json",serverless.status().json());
end _dsl_
savedsl(program,".lmweblab-local/up.dslb");let result=system(concat(dsl_cli(program),["--dry-run","--dsl",".lmweblab-local/up.dslb"]),120000);
assert(result.code==0,"offline up failed: "+result.stderr);println("PASS serverless up; persistent private state retained");println("estimated cost: $0.00");
