# === CONFIG ===
let REGION = getenv("AWS_REGION", "") != "" ? getenv("AWS_REGION", "") : "us-east-1";
let DOMAIN = getenv("LMWEBLAB_DOMAIN", "") != "" ? getenv("LMWEBLAB_DOMAIN", "") : "example.com";
let NAME_PREFIX = "lmaws";
let SCENARIO_SLUG = "s03";
let LAMBDA_ROLE_NAME = "lmaws_lambda_exec";
let RUNTIME = "python3.12";
let MEMORY_MB = 128;
let TIMEOUT_S = 10;
let LOG_RETENTION_DAYS = 1;
let PRICE_CLASS = "PriceClass_100";
let AWS_PROFILE_NAME = getenv("AWS_PROFILE", "") != "" ? getenv("AWS_PROFILE", "") : "lmaws";
let LIVE_MODE = getenv("LMWEBLAB_LIVE", "0") == "1";
let DEFAULT_RUN_ID = getenv("LMWEBLAB_RUN_ID", "") != "" ? getenv("LMWEBLAB_RUN_ID", "") : "demo01";
let APPLY_TIMEOUT_MS = 1200000;
# === END CONFIG ===

let live = LIVE_MODE;
let run_id = DEFAULT_RUN_ID;
let domain = DOMAIN;
let i = 0;
while (i < len(ARGV)) {
  let a = ARGV[i];
  if (a == "--live") { live = true; }
  else if (a == "--offline" || a == "--dry-run") { live = false; }
  else if (a == "--run-id" && i + 1 < len(ARGV)) { i = i + 1; run_id = ARGV[i]; }
  else if (a == "--domain" && i + 1 < len(ARGV)) { i = i + 1; domain = ARGV[i]; }
  i = i + 1;
}

let stack_dir = file_exists("main.tf") ? "." : "scenarios/03-lambda-function-url-hello/lmcloud";
let state_dir = path_join(stack_dir, ".lmweblab-local");
mkdir(state_dir);

if (live) {
  assert(AWS_PROFILE_NAME == "lmaws", "Live runs MUST use AWS_PROFILE=lmaws only");
  set_env("AWS_PROFILE", AWS_PROFILE_NAME);
  set_env("AWS_DEFAULT_PROFILE", AWS_PROFILE_NAME);
  set_env("AWS_REGION", REGION);
  set_env("AWS_DEFAULT_REGION", REGION);
} else {
  set_env("AWS_EC2_METADATA_DISABLED", "true");
}

let offline_str = live ? "false" : "true";
let profile_str = live ? AWS_PROFILE_NAME : "";
let mem_str = str(MEMORY_MB);
let timeout_str = str(TIMEOUT_S);
let ret_str = str(LOG_RETENTION_DAYS);
let out_meta_path = path_join(state_dir, "stack.json");
let t0 = now();

let up_prog = _dsl_ cli="lmcloud" install="github:lmctl-ai/lmcloud@latest";
let dir = ${stack_dir};
let run_id = ${run_id};
let name_prefix = ${NAME_PREFIX};
let scenario_slug = ${SCENARIO_SLUG};
let domain = ${domain};
let region = ${REGION};
let aws_profile = ${profile_str};
let offline_mode = ${offline_str};
let role_name = ${LAMBDA_ROLE_NAME};
let runtime = ${RUNTIME};
let mem_mb = ${mem_str};
let timeout_s = ${timeout_str};
let ret_days = ${ret_str};
let price_class = ${PRICE_CLASS};
let meta_file = ${out_meta_path};

if (!tofu.fmt_check(dir)) {
  print("FMT_ERROR: " + tofu.last_error());
  assert_close(0.0, 1.0, 0.0);
}
if (!tofu.init(dir)) {
  print("INIT_ERROR: " + tofu.last_error());
  assert_close(0.0, 1.0, 0.0);
}
if (!tofu.validate(dir)) {
  print("VALIDATE_ERROR: " + tofu.last_error());
  assert_close(0.0, 1.0, 0.0);
}

tofu.var("run_id", run_id);
tofu.var("name_prefix", name_prefix);
tofu.var("scenario_slug", scenario_slug);
tofu.var("domain", domain);
tofu.var("aws_region", region);
tofu.var("aws_profile", aws_profile);
tofu.var("offline_mode", offline_mode);
tofu.var("lambda_role_name", role_name);
tofu.var("runtime", runtime);
tofu.var("memory_mb", mem_mb);
tofu.var("timeout_s", timeout_s);
tofu.var("log_retention_days", ret_days);
tofu.var("price_class", price_class);

let p = tofu.plan(dir);
if (p.add() <= 0 && offline_mode == "true") {
  print("PLAN_ERROR: " + tofu.last_error());
  assert_close(0.0, 1.0, 0.0);
}
print("PLAN_SUMMARY: " + p.summary());

let fn_name = name_prefix + "_tf_" + scenario_slug + "_" + run_id;
let fn_url = "https://" + run_id + ".lambda-url." + region + ".on.aws/";
let cf_domain = "d0000000000000.cloudfront.net";
let api_fqdn = name_prefix + "-tf-" + scenario_slug + "-api-" + run_id + "." + domain;

if (offline_mode == "false") {
  if (!tofu.apply(dir)) {
    print("APPLY_ERROR: " + tofu.last_error());
    assert_close(0.0, 1.0, 0.0);
  }
  fn_name = str_trim(tofu.output(dir, "function_name"));
  fn_url = str_trim(tofu.output(dir, "function_url"));
  cf_domain = str_trim(tofu.output(dir, "distribution_domain_name"));
  api_fqdn = str_trim(tofu.output(dir, "api_fqdn"));
}

let mode_label = "offline";
if (offline_mode == "false") { mode_label = "live"; }

let meta_json = "{\n" +
  "  \"scenario\": \"03-lambda-function-url-hello\",\n" +
  "  \"engine\": \"lmcloud\",\n" +
  "  \"mode\": \"" + mode_label + "\",\n" +
  "  \"run_id\": \"" + run_id + "\",\n" +
  "  \"domain\": \"" + domain + "\",\n" +
  "  \"region\": \"" + region + "\",\n" +
  "  \"function_name\": \"" + fn_name + "\",\n" +
  "  \"function_url\": \"" + fn_url + "\",\n" +
  "  \"distribution_domain_name\": \"" + cf_domain + "\",\n" +
  "  \"api_fqdn\": \"" + api_fqdn + "\",\n" +
  "  \"planned_add\": " + str(p.add()) + "\n" +
  "}\n";
file_write(meta_file, meta_json);
end _dsl_

let dslb = path_join(state_dir, "up.dslb");
savedsl(up_prog, dslb);
let r = system(concat(dsl_cli(up_prog), ["--lmcode", dslb]), APPLY_TIMEOUT_MS);
let elapsed_ms = now() - t0;
println(r.stdout);
if (r.code != 0) { println(r.stderr); }
assert(r.code == 0, "scenario 03 up.lms failed");

write_file(path_join(state_dir, "up-timing.json"), json_stringify({
  scenario: "03-lambda-function-url-hello",
  engine: "lmcloud",
  mode: live ? "live" : "offline",
  run_id: run_id,
  elapsed_ms: elapsed_ms
}, 2));
println("ok - scenario 03 up.lms completed in " + str(elapsed_ms) + " ms");
println("estimated cost: " + (live ? "$0.0001" : "$0.0000"));
