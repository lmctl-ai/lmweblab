assert(!contains(ARGV,"--live"), "live mode is pending the Lambda role grant");
# === CONFIG ===
let REGION="us-east-1"; let NAME_PREFIX="lmaws"; let SCENARIO_SLUG="s04"; let RUNTIME="python3.12"; let MEMORY_MB=128; let TIMEOUT_S=10; let TTL_SECONDS=3600; let ROLE="lmaws_lambda_exec";
# === END CONFIG ===
assert(getenv("LMWEBLAB_LIVE","0") != "1", "live deployment pending the Lambda role grant");
mkdir(".lmweblab-local"); let run_id=getenv("LMWEBLAB_RUN_ID","cafe04"); let table=NAME_PREFIX+"_"+SCENARIO_SLUG+"_entries_"+run_id; let name=NAME_PREFIX+"_"+SCENARIO_SLUG+"_"+run_id;
let web_state=".lmweblab-local/web-"+run_id+".json"; let serverless_state=".lmweblab-local/serverless-"+run_id+".json";
let p=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud=aws.demo(); let serverless=cloud.serverless_stack(${run_id},"example.com",${serverless_state}); let table_row=serverless.step("table","{\"name\":\""+${table}+"\",\"ttl_attribute\":\"expires_at\",\"billing\":\"PAY_PER_REQUEST\"}"); let lambda_row=serverless.step("lambda","{\"runtime\":\""+${RUNTIME}+"\",\"handler\":\"guestbook.handler\",\"source_file\":\"assets/guestbook.py\",\"role\":\""+${ROLE}+"\",\"table\":\""+${table}+"\",\"ttl_seconds\":"+str(${TTL_SECONDS})+",\"memory_mb\":"+str(${MEMORY_MB})+",\"timeout_s\":"+str(${TIMEOUT_S})+"}"); file_write(".lmweblab-local/state.json","{\"scenario\":\"04\",\"run_id\":\""+${run_id}+"\",\"table\":\""+${table}+"\",\"name\":\""+lambda_row.get("lambda_name")+"\",\"endpoint\":\"http://fixture.local/\",\"ttl_s\":"+str(${TTL_SECONDS})+"}"); file_write(".lmweblab-local/up.json","{\"table\":"+table_row.json()+",\"lambda\":"+lambda_row.json()+"}");
end _dsl_
savedsl(p,".lmweblab-local/up.dslb"); let r=system(concat(dsl_cli(p),["--dry-run","--dsl",".lmweblab-local/up.dslb"]),120000); assert(r.code==0); println("PASS scenario 04 up (offline fake transport)"); println("estimated cost: $0.0000");
