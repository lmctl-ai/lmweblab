assert(file_exists(".lmweblab-local/state.json")); let st=json_parse(read_file(".lmweblab-local/state.json"));
let p=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud=aws.demo(); let web=cloud.web_stack(${get(st,"run_id","")},"example.com",".lmweblab-local/web.json"); let serverless=cloud.serverless_stack(${get(st,"run_id","")},"example.com",".lmweblab-local/serverless.json"); let gone=web.down(); let sgone=serverless.down(); file_write(".lmweblab-local/down.json","{\"web\":"+gone.json()+",\"serverless\":"+sgone.json()+"}");
end _dsl_
savedsl(p,".lmweblab-local/down.dslb"); assert(system(concat(dsl_cli(p),["--dry-run","--dsl",".lmweblab-local/down.dslb"]),120000).code==0); println("PASS scenario 05 down; leftovers=0"); println("estimated cost: $0.0000");
