# === CONFIG ===
let REGION="us-east-1"; let NAME_PREFIX="lmaws"; let SCENARIO_SLUG="s05"; let RUNTIME="python3.12"; let MEMORY_MB=128; let TIMEOUT_S=10; let ROLE="lmaws_lambda_exec";
# === END CONFIG ===
mkdir(".lmweblab-local"); remove_file(".lmweblab-local/run.json"); let run_id=getenv("LMWEBLAB_RUN_ID","s05demo"); let bucket=NAME_PREFIX+"-"+SCENARIO_SLUG+"-"+run_id; let name=NAME_PREFIX+"_"+SCENARIO_SLUG+"_"+run_id;
let p=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud=aws.demo(); let run=cloud.run(${run_id},".lmweblab-local/run.json"); let b=run.bucket(${bucket}); let lambda=cloud.lambda_function(${name},${ROLE},${RUNTIME},"api.handler","def handler(event, context): return {'statusCode':200,'body':'{\\\"ok\\\":true,\\\"source\\\":\\\"api\\\"}'}",${MEMORY_MB},${TIMEOUT_S}); let endpoint=lambda.url("Scenario 05 public API origin is intentionally NONE-authenticated for offline routing tests"); file_write(".lmweblab-local/state.json","{\"scenario\":\"05\",\"run_id\":\""+${run_id}+"\",\"bucket\":\""+${bucket}+"\",\"name\":\""+${name}+"\",\"endpoint\":\""+endpoint+"\"}"); file_write(".lmweblab-local/up.json","{\"bucket\":"+b.json()+",\"lambda\":"+lambda.status().json()+"}");
end _dsl_
savedsl(p,".lmweblab-local/up.dslb"); let r=system(concat(dsl_cli(p),["--dry-run","--dsl",".lmweblab-local/up.dslb"]),120000); assert(r.code==0); println("PASS scenario 05 up (offline fake transport)"); println("estimated cost: $0.0000");
