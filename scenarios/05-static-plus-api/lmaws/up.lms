# === CONFIG ===
let REGION="us-east-1"; let NAME_PREFIX="lmaws"; let SCENARIO_SLUG="s05"; let RUNTIME="python3.12"; let MEMORY_MB=128; let TIMEOUT_S=10; let ROLE="lmaws_lambda_exec";
# === END CONFIG ===
assert(getenv("LMWEBLAB_LIVE","0") != "1", "live deployment pending the Lambda role grant");
mkdir(".lmweblab-local"); let run_id=getenv("LMWEBLAB_RUN_ID","cafe05"); let bucket=NAME_PREFIX+"-"+SCENARIO_SLUG+"-"+run_id; let name=NAME_PREFIX+"_"+SCENARIO_SLUG+"_"+run_id;
let p=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let web=cloud.web_stack(${run_id},"example.com",".lmweblab-local/web.json"); let serverless=cloud.serverless_stack(${run_id},"example.com",".lmweblab-local/serverless.json"); let b=web.step("bucket","{\"site_dir\":\"../../../shared/site\"}"); let cert=web.step("certificate","{}"); let lambda_row=serverless.step("lambda","{\"runtime\":\""+${RUNTIME}+"\",\"handler\":\"api.handler\",\"source_file\":\"assets/api.py\",\"role\":\""+${ROLE}+"\",\"memory_mb\":"+str(${MEMORY_MB})+",\"timeout_s\":"+str(${TIMEOUT_S})+"}"); let dist=web.step("lambda_distribution","{\"function_name\":\""+lambda_row.get("lambda_name")+"\",\"lambda_url\":\""+lambda_row.get("lambda_url")+"\",\"mixed\":true}"); let dns=web.step("dns_site","{}"); file_write(".lmweblab-local/state.json","{\"scenario\":\"05\",\"run_id\":\""+${run_id}+"\",\"bucket\":\""+${bucket}+"\",\"name\":\""+lambda_row.get("lambda_name")+"\",\"endpoint\":\"http://dfixture.cloudfront.net/\"}"); file_write(".lmweblab-local/up.json","{\"web\":"+dns.json()+",\"serverless\":"+lambda_row.json()+"}");
end _dsl_
savedsl(p,".lmweblab-local/up.dslb"); let r=system(concat(dsl_cli(p),["--dry-run","--dsl",".lmweblab-local/up.dslb"]),120000); assert(r.code==0); println("PASS scenario 05 up (offline fake transport)"); println("estimated cost: $0.0000");
