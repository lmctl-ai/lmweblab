# === CONFIG ===
let REGION = "us-east-1";
let DOMAIN = getenv("LMWEBLAB_DOMAIN", "example.com");
# === END CONFIG ===
assert(!contains(ARGV,"--live")&&getenv("LMWEBLAB_LIVE","0")!="1", "live serverless rollout awaits authorization");
assert(file_exists(".lmweblab-local/state.json"),"run up first");
let metadata=json_parse(read_file(".lmweblab-local/state.json"));let run_id=metadata.run_id;
let serverless_path=".lmweblab-local/serverless-"+run_id+".json";
let domain=json_parse(read_file(serverless_path)).domain;
let program=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud=aws.demo();let run=cloud.serverless_stack(${run_id},${domain},${serverless_path});
file_write(".lmweblab-local/status.json",run.status().json());
end _dsl_
savedsl(program,".lmweblab-local/status.dslb");
let result=system(concat(dsl_cli(program),["--dry-run","--dsl",".lmweblab-local/status.dslb"]),120000);assert(result.code==0,"status query failed");
println(read_file(".lmweblab-local/status.json"));println("estimated cost: $0.00");
