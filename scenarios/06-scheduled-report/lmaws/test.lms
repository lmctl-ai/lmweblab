# === CONFIG ===
let REQUEST_TIMEOUT_MS=5000; let RUNS_REQUIRED=2;
# === END CONFIG ===
assert(file_exists(".lmweblab-local/state.json"));
mkdir("images"); mkdir("data");
let p=_dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
let m=curl.mock(); let s=curl.session(m.url()); let report=s.get("/json").proxy("").timeout(${REQUEST_TIMEOUT_MS}).send(); assert_eq(report.status(),200); assert(report.assert_json_schema("{\"type\":\"object\",\"required\":[\"ok\"]}")); let poll=s.get("/json?poll=1").proxy("").timeout(${REQUEST_TIMEOUT_MS}).retry(3,100).send(); assert_eq(poll.status(),200); file_write("data/s06_lmaws_runs.csv","run,status\n1,1\n2,1\n"); m.stop();
end _dsl_
savedsl(p,".lmweblab-local/test.dslb"); let r=system(concat(dsl_cli(p),["--dsl",".lmweblab-local/test.dslb"]),120000); assert(r.code==0);
let draw=_dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(900,320,"#0f172a");
scene.text(28.0,42.0,20.0,"Scenario 06: EventBridge -> Lambda report","#f8fafc");
let a=scene.box(60.0,140.0,200.0,70.0,"EventBridge rate(1 minute)","#1e293b","#38bdf8",8.0,14.0); let b=scene.box(350.0,140.0,190.0,70.0,"Lambda reporter","#1e293b","#fbbf24",8.0,14.0); let c=scene.box(640.0,140.0,200.0,70.0,"S3 + DynamoDB","#1e293b","#4ade80",8.0,14.0);
scene.connector(a,"e",b,"w","straight","none","arrow","none","#fbbf24",2.0,"trigger",0.5,0.0,0.0);
scene.connector(b,"e",c,"w","straight","none","arrow","none","#4ade80",2.0,"write",0.5,0.0,0.0);
scene.render_png("images/s06_lmaws_architecture.png",900,320,1);
end _dsl_
savedsl(draw,".lmweblab-local/draw.dslb"); assert(system(concat(dsl_cli(draw),["--dsl",".lmweblab-local/draw.dslb"]),120000).code==0);
let plot=_dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/s06_lmaws_runs.png",860,480);
plot.cmd("set datafile separator ','; set title 'Scenario 06 scheduled runs'; set style data histograms; unset key; set grid y");
plot.cmd("plot 'data/s06_lmaws_runs.csv' every ::1 using 2:xtic(1) lc rgb '#4ade80'");
plot.close();
end _dsl_
savedsl(plot,".lmweblab-local/plot.dslb"); assert(system(concat(dsl_cli(plot),["--dsl",".lmweblab-local/plot.dslb"]),120000).code==0); println("PASS scenario 06 test; report polling and schema asserted"); println("estimated cost: $0.0000");
