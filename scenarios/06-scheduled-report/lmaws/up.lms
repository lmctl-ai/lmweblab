# === CONFIG ===
let REGION="us-east-1"; let NAME_PREFIX="lmaws"; let SCENARIO_SLUG="s06"; let RUNTIME="python3.12"; let MEMORY_MB=128; let TIMEOUT_S=10; let SCHEDULE="rate(1 minute)"; let ROLE="lmaws_lambda_exec";
# === END CONFIG ===
assert(getenv("LMWEBLAB_LIVE","0") != "1", "live deployment pending the Lambda role grant");
mkdir(".lmweblab-local"); let run_id=getenv("LMWEBLAB_RUN_ID","cafe06"); let bucket=NAME_PREFIX+"-"+SCENARIO_SLUG+"-"+run_id; let table=NAME_PREFIX+"_"+SCENARIO_SLUG+"_runs_"+run_id; let name=NAME_PREFIX+"_"+SCENARIO_SLUG+"_"+run_id; let rule=NAME_PREFIX+"_"+SCENARIO_SLUG+"_rule_"+run_id;
let p=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let cloud=aws.demo(); let serverless=cloud.serverless_stack(${run_id},"example.com",".lmweblab-local/serverless.json"); let bucket_row=serverless.step("bucket","{\"name\":\""+${bucket}+"\"}"); let table_row=serverless.step("table","{\"name\":\""+${table}+"\",\"billing\":\"PAY_PER_REQUEST\"}"); let lambda_row=serverless.step("lambda","{\"runtime\":\""+${RUNTIME}+"\",\"handler\":\"reporter.handler\",\"source_file\":\"assets/reporter.py\",\"role\":\""+${ROLE}+"\",\"bucket\":\""+${bucket}+"\",\"table\":\""+${table}+"\",\"memory_mb\":"+str(${MEMORY_MB})+",\"timeout_s\":"+str(${TIMEOUT_S})+"}"); let event_row=serverless.step("event","{\"name\":\""+${rule}+"\",\"schedule\":\""+${SCHEDULE}+"\",\"target\":\""+lambda_row.get("lambda_name")+"\"}"); file_write(".lmweblab-local/state.json","{\"scenario\":\"06\",\"run_id\":\""+${run_id}+"\",\"bucket\":\""+${bucket}+"\",\"table\":\""+${table}+"\",\"name\":\""+lambda_row.get("lambda_name")+"\",\"rule\":\""+${rule}+"\",\"schedule\":\""+${SCHEDULE}+"\"}"); file_write(".lmweblab-local/up.json","{\"bucket\":"+bucket_row.json()+",\"table\":"+table_row.json()+",\"lambda\":"+lambda_row.json()+",\"event\":"+event_row.json()+"}");
end _dsl_
savedsl(p,".lmweblab-local/up.dslb"); let r=system(concat(dsl_cli(p),["--dry-run","--dsl",".lmweblab-local/up.dslb"]),120000); assert(r.code==0); println("PASS scenario 06 up (offline fake transport)"); println("estimated cost: $0.0000");
