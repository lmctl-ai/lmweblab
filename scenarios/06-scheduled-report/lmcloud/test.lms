# === CONFIG ===
let NAME_PREFIX = "lmaws";
let SCENARIO_SLUG = "s06";
let SCHEDULE_EXPRESSION = "rate(1 minute)";
let REQUEST_TIMEOUT_MS = 10000;
let POLL_MAX_ATTEMPTS = 18;
let POLL_SLEEP_MS = 5000;
let LOAD_VUS = 2;
let LOAD_DURATION_S = "10.0";
let LOAD_REQUESTS = 8;
let P95_THRESHOLD_MS = "5000.0";
let LIVE_MODE = getenv("LMWEBLAB_LIVE", "0") == "1";
let DEFAULT_RUN_ID = getenv("LMWEBLAB_RUN_ID", "") != "" ? getenv("LMWEBLAB_RUN_ID", "") : "demo01";
# === END CONFIG ===

let live = LIVE_MODE;
let run_id = DEFAULT_RUN_ID;
let i = 0;
while (i < len(ARGV)) {
  let a = ARGV[i];
  if (a == "--live") { live = true; }
  else if (a == "--offline" || a == "--dry-run") { live = false; }
  else if (a == "--run-id" && i + 1 < len(ARGV)) { i = i + 1; run_id = ARGV[i]; }
  i = i + 1;
}

let stack_dir = file_exists("main.tf") ? "." : "scenarios/06-scheduled-report/lmcloud";
let state_dir = path_join(stack_dir, ".lmweblab-local");
mkdir(state_dir);
mkdir("images");
mkdir("data");

let fn_url = "";
let meta_path = path_join(state_dir, "stack.json");
if (file_exists(meta_path)) {
  let meta = json_parse(read_file(meta_path));
  fn_url = str(get(meta, "function_url", ""));
  if (run_id == "demo01") { run_id = str(get(meta, "run_id", run_id)); }
  if (get(meta, "mode", "offline") == "live") { live = true; }
}

let csv_path = "data/s06_lmcloud_runs.csv";
let arch_img = "images/s06_lmcloud_architecture.png";
let plot_img = "images/s06_lmcloud_runs.png";
let summary_path = path_join(state_dir, "test-summary.json");
let t0 = now();

if (!live) {
  let p = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
  let m = curl.mock();
  let base = m.url();
  let s = curl.session(base);
  let timeout_ms = ${REQUEST_TIMEOUT_MS};
  let out_csv = ${csv_path};

  let r_manual = s.post("/echo").json("{\"trigger\":\"manual\"}").proxy("").timeout(timeout_ms).send();
  let r_sched = s.get("/json").proxy("").timeout(timeout_ms).send();
  assert_eq(r_manual.status(), 200);
  assert_eq(r_sched.status(), 200);

  let csv = "step,reports_count,latency_ms\n" +
    "Manual Trigger,1," + str(r_manual.time("total")) + "\n" +
    "After Schedule,2," + str(r_sched.time("total")) + "\n";
  file_write(out_csv, csv);
  m.stop();
end _dsl_
  let dslb = path_join(state_dir, "test.dslb");
  savedsl(p, dslb);
  let r = system(concat(dsl_cli(p), ["--lmcode", dslb]), 60000);
  assert(r.code == 0, "scenario 06 offline test failed: " + r.stderr);
} else {
  assert(fn_url != "", "Live test requires function_url in .lmweblab-local/stack.json");
  let init_prog = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
  let base = ${fn_url};
  let s = curl.session(base);
  let timeout_ms = ${REQUEST_TIMEOUT_MS};
  let out_sum = ${summary_path};

  let r_cold = s.get("/").timeout(timeout_ms).retry(5, 1000).send();
  assert_eq(r_cold.status(), 200);
  assert_eq(r_cold.json("$.ok").value(), "true");

  let r_warm = s.get("/").timeout(timeout_ms).send();
  assert_eq(r_warm.status(), 200);

  let r_manual = s.post("/").json("{\"trigger\":\"manual\"}").timeout(timeout_ms).send();
  assert_eq(r_manual.status(), 200);
  assert_eq(r_manual.json("$.ok").value(), "true");

  file_write(out_sum, "{\n" +
    "  \"cold_ms\": " + str(r_cold.time("total")) + ",\n" +
    "  \"warm_ms\": " + str(r_warm.time("total")) + ",\n" +
    "  \"manual_post_ms\": " + str(r_manual.time("total")) + "\n" +
    "}\n");
end _dsl_
  let init_dslb = path_join(state_dir, "test-init.dslb");
  savedsl(init_prog, init_dslb);
  let r_init = system(concat(dsl_cli(init_prog), ["--lmcode", init_dslb]), 60000);
  if (r_init.code != 0) { println(r_init.stderr); }
  assert(r_init.code == 0, "scenario 06 live initial probe failed: " + r_init.stderr);

  # Bounded poll waiting for EventBridge rate(1 minute) scheduled run
  let poll_out_path = path_join(state_dir, "poll-status.json");
  let attempt = 1;
  let eb_seen = false;
  let final_runs = 1;
  let final_get_ms = 0.0;
  while (attempt <= POLL_MAX_ATTEMPTS && !eb_seen) {
    let poll_prog = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
    let base = ${fn_url};
    let s = curl.session(base);
    let timeout_ms = ${REQUEST_TIMEOUT_MS};
    let out_p = ${poll_out_path};
    let r_get = s.get("/").timeout(timeout_ms).send();
    assert_eq(r_get.status(), 200);
    file_write(out_p, "{\n" +
      "  \"scheduled_runs\": " + str(r_get.json("$.scheduled_runs").to_int()) + ",\n" +
      "  \"eventbridge_runs\": " + str(r_get.json("$.eventbridge_runs").to_int()) + ",\n" +
      "  \"get_ms\": " + str(r_get.time("total")) + "\n" +
      "}\n");
end _dsl_
    let poll_dslb = path_join(state_dir, "test-poll.dslb");
    savedsl(poll_prog, poll_dslb);
    let r_p = system(concat(dsl_cli(poll_prog), ["--lmcode", poll_dslb]), 30000);
    if (r_p.code == 0 && file_exists(poll_out_path)) {
      let st = json_parse(read_file(poll_out_path));
      if (num(get(st, "eventbridge_runs", 0)) >= 1 && num(get(st, "scheduled_runs", 0)) >= 2) {
        eb_seen = true;
        final_runs = num(get(st, "scheduled_runs", 2));
        final_get_ms = num(get(st, "get_ms", 0));
      }
    }
    if (!eb_seen) {
      sleep_ms(POLL_SLEEP_MS);
    }
    attempt = attempt + 1;
  }
  assert(eb_seen, "EventBridge rate(1 minute) did not record a run within bounded poll window");

  # Verify HTML report from S3 and run 4-VU load check
  let load_prog = _dsl_ cli="lmcurl" install="github:lmctl-ai/lmcurl@latest";
  let base = ${fn_url};
  let s = curl.session(base);
  let timeout_ms = ${REQUEST_TIMEOUT_MS};
  let load_vus = ${LOAD_VUS};
  let load_dur = str_to_float(${LOAD_DURATION_S});
  let load_reqs = ${LOAD_REQUESTS};
  let p95_max = str_to_float(${P95_THRESHOLD_MS});
  let out_sum = ${summary_path};

  let r_html = s.get("/?format=html").timeout(timeout_ms).send();
  assert_eq(r_html.status(), 200);
  assert_eq(str_contains(r_html.body(), "lmweblab Scheduled Report"), true);

  let load_res = curl.load(s.get("/"), load_vus, load_dur, load_reqs);
  assert_eq(load_res.threshold(p95_max, 0.0), true);

  file_write(out_sum + ".load.json", "{\n" +
    "  \"html_ms\": " + str(r_html.time("total")) + ",\n" +
    "  \"load_p50_ms\": " + str(load_res.p50_ms()) + ",\n" +
    "  \"load_p95_ms\": " + str(load_res.p95_ms()) + ",\n" +
    "  \"load_p99_ms\": " + str(load_res.p99_ms()) + "\n" +
    "}\n");
end _dsl_
  let load_dslb = path_join(state_dir, "test-load.dslb");
  savedsl(load_prog, load_dslb);
  let r_load = system(concat(dsl_cli(load_prog), ["--lmcode", load_dslb]), 60000);
  assert(r_load.code == 0, "scenario 06 HTML/load check failed: " + r_load.stderr);

  let init_sum = json_parse(read_file(summary_path));
  let load_sum = json_parse(read_file(summary_path + ".load.json"));
  write_file(summary_path, json_stringify(merge(init_sum, merge(load_sum, {
    final_runs: final_runs,
    final_get_ms: final_get_ms,
    poll_attempts: attempt - 1
  })), 2));

  let csv = "step,reports_count,latency_ms\n" +
    "Manual Trigger,1," + str(get(init_sum, "manual_post_ms", 0)) + "\n" +
    "After Schedule," + str(final_runs) + "," + str(final_get_ms) + "\n";
  write_file(csv_path, csv);
}

let arch = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
let out_png = ${arch_img};
let prefix = ${NAME_PREFIX};
let slug = ${SCENARIO_SLUG};
let sched = ${SCHEDULE_EXPRESSION};
scene.canvas(920, 360, "#0f172a");
scene.text(32.0, 42.0, 20.0, "Scenario 06: Scheduled Report — EventBridge + Lambda + S3 + DynamoDB (lmcloud)", "#f8fafc").set_attr("font-weight", "700");
scene.text(32.0, 68.0, 13.0, "EventBridge (" + sched + ") -> Lambda Reporter -> S3 Bucket + DynamoDB Ledger", "#94a3b8");
scene.cluster(32.0, 96.0, 856.0, 220.0, "", "#131c2e", "#334155", 10.0, 13.0);
let eb = scene.box(130.0, 205.0, 175.0, 68.0, "EventBridge Rule\n" + sched, "#1e293b", "#38bdf8", 8.0, 13.0);
let fn_b = scene.box(385.0, 205.0, 185.0, 68.0, "Lambda Reporter\n" + prefix + "_tf_" + slug + "_<id>", "#1e293b", "#fbbf24", 8.0, 13.0);
let s3_b = scene.box(645.0, 155.0, 195.0, 58.0, "S3 Reports Bucket\n" + prefix + "-tf-" + slug + "-<id>", "#1e293b", "#34d399", 8.0, 12.0);
let ddb_b = scene.box(645.0, 245.0, 195.0, 58.0, "DynamoDB Runs Table\n" + prefix + "_tf_" + slug + "_runs_<id>", "#1e293b", "#a855f7", 8.0, 12.0);
scene.connector(eb, "e", fn_b, "w", "straight", "none", "arrow", "none", "#38bdf8", 2.0, "Invoke", 0.5, 0.0, -10.0);
scene.connector(fn_b, "e", s3_b, "w", "straight", "none", "arrow", "none", "#34d399", 2.0, "PutObject", 0.5, 0.0, -10.0);
scene.connector(fn_b, "e", ddb_b, "w", "straight", "none", "arrow", "none", "#a855f7", 2.0, "PutItem", 0.5, 0.0, 12.0);
scene.render_png(out_png, 920, 360, 1);
end _dsl_
let arch_dslb = path_join(state_dir, "arch.dslb");
savedsl(arch, arch_dslb);
assert(system(concat(dsl_cli(arch), ["--lmcode", arch_dslb]), 60000).code == 0);

let plot = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png(${plot_img}, 860, 480);
plot.cmd("set datafile separator ','");
plot.cmd("set title 'Scenario 06 (lmcloud): Recorded Report Runs (S3 + DynamoDB)' noenhanced");
plot.cmd("set yrange [0:*]; set offsets 0,0,graph 0.2,0; set grid y; unset key; set style fill solid 0.85; set boxwidth 0.5");
plot.cmd("set ylabel 'Cumulative Reports'");
plot.cmd("plot '" + ${csv_path} + "' every ::1 using 0:2:xtic(1) with boxes lc rgb '#34d399', '' every ::1 using 0:2:(sprintf('%d runs',$2)) with labels offset 0,0.8");
plot.close();
end _dsl_
let plot_dslb = path_join(state_dir, "plot.dslb");
savedsl(plot, plot_dslb);
assert(system(concat(dsl_cli(plot), ["--lmcode", plot_dslb]), 60000).code == 0);

if (stack_dir != ".") {
  mkdir(path_join(stack_dir, "images"));
  write_file(path_join(stack_dir, arch_img), read_file(arch_img));
  write_file(path_join(stack_dir, plot_img), read_file(plot_img));
}
let elapsed_ms = now() - t0;
write_file(path_join(state_dir, "test-timing.json"), json_stringify({
  scenario: "06-scheduled-report",
  mode: live ? "live" : "offline",
  run_id: run_id,
  elapsed_ms: elapsed_ms
}, 2));
println("ok - scenario 06 test.lms passed in " + str(elapsed_ms) + " ms");
println("estimated cost: $0.0000");
