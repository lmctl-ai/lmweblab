# === CONFIG ===
let IMAGE_WIDTH=900;let IMAGE_HEIGHT=500;
# === END CONFIG ===
let REGION="us-east-1";
let IMAGE="images/s07_lmaws_architecture.png";
let plot=_dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/s07_lmaws_queue.png",900,500);plot.cmd("set datafile separator ','");plot.cmd("set title 'SQS worker lifecycle (synthetic)'");plot.cmd("set style data histograms; set style fill solid 0.85; set boxwidth 0.65; set style histogram clustered gap 1");plot.cmd("plot 'data/queue_results.csv' skip 1 using 2:xtic(1) lc rgb '#38bdf8' notitle");plot.close();
end _dsl_
savedsl(plot,".report.dslb");let r=system(concat(dsl_cli(plot),["--lmcode",".report.dslb"]),60000);assert(r.code==0,"lmplot report failed: "+r.stderr);
let draw=_dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(900,500,"#0d1117");scene.text(450.0,42.0,24.0,"SQS Worker + DynamoDB + DLQ","#e6edf3").set_attr("text-anchor","middle");scene.rect(50.0,180.0,180.0,100.0,"#161b22").set_attr("stroke","#58a6ff").set_attr("stroke-width","2");scene.text(140.0,230.0,16.0,"API Lambda","#58a6ff").set_attr("text-anchor","middle");scene.arrow(240.0,230.0,350.0,230.0,"#3fb950",3.0);scene.rect(360.0,180.0,180.0,100.0,"#161b22").set_attr("stroke","#3fb950").set_attr("stroke-width","2");scene.text(450.0,230.0,16.0,"SQS queue","#3fb950").set_attr("text-anchor","middle");scene.arrow(550.0,230.0,660.0,230.0,"#a371f7",3.0);scene.rect(670.0,180.0,180.0,100.0,"#161b22").set_attr("stroke","#a371f7").set_attr("stroke-width","2");scene.text(760.0,220.0,15.0,"Worker Lambda","#a371f7").set_attr("text-anchor","middle");scene.text(760.0,245.0,12.0,"DDB idempotency","#c9d1d9").set_attr("text-anchor","middle");scene.arrow(450.0,290.0,450.0,390.0,"#ff7b72",3.0);scene.text(450.0,425.0,14.0,"DLQ after 3 receives","#ff7b72").set_attr("text-anchor","middle");scene.render_png("images/s07_lmaws_architecture.png",900,500,1);
end _dsl_
savedsl(draw,".draw.dslb");let d=system(concat(dsl_cli(draw),["--lmcode",".draw.dslb"]),60000);assert(d.code==0,"lmdraw report failed");
