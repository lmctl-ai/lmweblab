# === CONFIG ===
let IMAGE_WIDTH=900;let IMAGE_HEIGHT=500;
# === END CONFIG ===
let REGION="us-east-1";
let IMAGE="images/s08_lmaws_architecture.png";
let plot=_dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/s08_lmaws_flow.png",900,500);plot.cmd("set datafile separator ','");plot.cmd("set title 'Session login contract (synthetic)'");plot.cmd("set ylabel 'assertion passed'");plot.cmd("set yrange [0:1.2]");plot.cmd("set style data histograms; set style fill solid 0.85; set boxwidth 0.65; set style histogram clustered gap 1");plot.cmd("plot 'data/session_flow.csv' skip 1 using 2:xtic(1) lc rgb '#38bdf8' notitle");plot.close();
end _dsl_
savedsl(plot,".report.dslb");let r=system(concat(dsl_cli(plot),["--dsl",".report.dslb"]),60000);assert(r.code==0,"lmplot report failed: "+r.stderr);
let draw=_dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(900,500,"#0d1117");scene.text(450.0,42.0,24.0,"Session Login: Lambda + DynamoDB TTL","#e6edf3").set_attr("text-anchor","middle");scene.rect(60.0,180.0,220.0,100.0,"#161b22").set_attr("stroke","#58a6ff").set_attr("stroke-width","2");scene.text(170.0,230.0,16.0,"Lambda URL","#58a6ff").set_attr("text-anchor","middle");scene.arrow(290.0,230.0,400.0,230.0,"#3fb950",3.0);scene.rect(410.0,180.0,220.0,100.0,"#161b22").set_attr("stroke","#3fb950").set_attr("stroke-width","2");scene.text(520.0,220.0,15.0,"DynamoDB sessions","#3fb950").set_attr("text-anchor","middle");scene.text(520.0,245.0,12.0,"TTL + cookie","#c9d1d9").set_attr("text-anchor","middle");scene.arrow(640.0,230.0,760.0,230.0,"#ff7b72",3.0);scene.text(800.0,220.0,14.0,"logout / expiry","#ff7b72").set_attr("text-anchor","middle");scene.render_png("images/s08_lmaws_architecture.png",900,500,1);
end _dsl_
savedsl(draw,".draw.dslb");let d=system(concat(dsl_cli(draw),["--dsl",".draw.dslb"]),60000);assert(d.code==0,"lmdraw report failed");
