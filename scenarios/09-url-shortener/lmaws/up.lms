# === CONFIG ===
let REGION = "us-east-1";
let DOMAIN = getenv("LMWEBLAB_DOMAIN", "example.com");
let NAME_PREFIX = "lmaws";
let SLUG = "url_shortener";
let ROLE = "lmaws_lambda_exec";
let RUNTIME = "python3.12";
let TTL_SECONDS=3600;
let MEMORY_MB = 128;
let TIMEOUT_S = 10;
let HANDLER = "url_shortener.handler";
let SOURCE_FILE = "assets/url_shortener.py";
let COST_CAP_USD = "0.05";
# === END CONFIG ===
import "../../lib/remaining.lms";
rw_run("09", "up", {region:REGION,domain:DOMAIN,prefix:NAME_PREFIX,slug:SLUG,role:ROLE,runtime:RUNTIME,ttl_seconds:TTL_SECONDS,memory_mb:MEMORY_MB,timeout_s:TIMEOUT_S,handler:HANDLER,source_file:SOURCE_FILE,cap:COST_CAP_USD}, ARGV);
