# Remaining serverless scenarios. Offline is the default; live requires a later Lead go.
import "./remaining_contracts.lms";
import "./remaining_upload.lms";
fn rw_exec(p,o,label,limit) {
  let code=".lmweblab-local/"+label+".dslb";savedsl(p,code);
  let command=concat(dsl_cli(p),[o.live?"--live":"--dry-run","--profile","lmaws","--dsl",code]);
  let r=system(concat(["env","AWS_PROFILE=lmaws","AWS_DEFAULT_PROFILE=lmaws","AWS_REGION="+o.region,"LMAWS_LIVE="+(o.live?"1":"0"),"LMAWS_MAX_COST_USD="+(o.number=="10"?str(num(o.cap)/2):o.cap),"LMAWS_LEDGER_DIR=.lmweblab-local/ledgers","LMAWS_EVIDENCE_DIR=.lmweblab-local/evidence"],command),limit);
  write_file(".lmweblab-local/"+label+".log",r.stdout+r.stderr);assert(r.code==0,"lmaws failed; inspect private "+label+".log");
}
fn rw_step(o,op,args) {
  let encoded=json_stringify(args);let state=".lmweblab-local/serverless-"+o.run_id+".json";
  let p=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let c=aws.region(${o.region});if(${!o.live}){c=c.demo();}check(c.is_demo()==${!o.live});
let run=c.serverless_stack(${o.run_id},${o.domain},${state});let result=run.step(${op},${encoded});file_write(".lmweblab-local/state.json",run.status().json());
end _dsl_
  rw_exec(p,o,op,240000);return json_parse(read_file(".lmweblab-local/state.json"));
}
fn rw_web(o,op,args) {
  let encoded=json_stringify(args);let state=".lmweblab-local/web-"+o.run_id+".json";
  let p=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let c=aws.region(${o.region});if(${!o.live}){c=c.demo();}check(c.is_demo()==${!o.live});
let web=c.web_stack(${o.run_id},${o.domain},${state});let result=web.step(${op},${encoded});
end _dsl_
  rw_exec(p,o,"web-"+op,1800000);
}
fn rw_up(o) {
  if(o.number!="10"){rw_step(o,"table",{ttl_attribute:"expires_at"});}
  if(o.number=="07"){rw_step(o,"queues",{});}
  if(o.number=="10"){rw_web(o,"bucket",{site_dir:"assets/site"});rw_web(o,"distribution",{});rw_web(o,"cache",{default_ttl:o.cache_seconds,max_ttl:o.cache_seconds});}
  let args={slug:o.slug,role:o.role,runtime:o.runtime,handler:o.handler,source_file:o.source_file,memory_mb:o.memory_mb,timeout_s:o.timeout_s,ttl_seconds:o.ttl_seconds};
  if(o.number=="10"){args.upload_bucket="lmaws-site-"+o.run_id;args.max_upload_bytes=get(o,"max_upload_bytes",1048576);args.upload_expiry_seconds=get(o,"upload_expiry_seconds",300);args.content_types=get(o,"content_types","image/png,image/jpeg,image/webp,image/gif");}
  rw_step(o,"lambda",args);
  if(o.number=="07"){rw_step(o,"worker",{source_file:o.worker_source,handler:"worker.handler",role:o.role,runtime:o.runtime,memory_mb:o.memory_mb,timeout_s:o.timeout_s});}
  rw_step(o,"reserve_http",{requests:100,bytes:2097152});
}
fn rw_down(o) {
  let state=".lmweblab-local/serverless-"+o.run_id+".json";
  let p=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let c=aws.region(${o.region});if(${!o.live}){c=c.demo();}
let run=c.serverless_stack(${o.run_id},${o.domain},${state});let removed=run.down();check(run.leftovers().len()==0);file_write(".lmweblab-local/down.json",removed.json());
end _dsl_
  rw_exec(p,o,"down",240000);
  let webstate=".lmweblab-local/web-"+o.run_id+".json";
  if(file_exists(webstate)) {
    let pweb=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let c=aws.region(${o.region});if(${!o.live}){c=c.demo();}let web=c.web_stack(${o.run_id},${o.domain},${webstate});let removed=web.down();check(web.leftovers().len()==0);
end _dsl_
    rw_exec(pweb,o,"web-down",1800000);
  }
  let audit=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let c=aws.region(${o.region});if(${!o.live}){c=c.demo();}check(c.serverless_find(${o.run_id}).len()==0);if(${o.number}=="07"){check(c.sqs_event_source_mappings(${o.run_id}).len()==0);}if(${o.number}=="10"){check(c.web_find(${o.run_id},${o.domain}).len()==0);}
file_write(".lmweblab-local/audit.json","{\"leftovers\":0,\"synthetic\":"+str(${!o.live})+"}");
end _dsl_
  rw_exec(audit,o,"audit",180000);
}
fn rw_run(number,action,config,argv) {
  let o=merge(config,{number:number,live:false,run_id:"cafe"+number});
  let i=0;while(i<len(argv)) {
    if(argv[i]=="--config"){i=i+1;o=merge(o,json_parse(read_file(argv[i])));}
    else if(argv[i]=="--live"){o.live=true;}
    else if(argv[i]=="--offline"){o.live=false;}
    else if(argv[i]=="--run-id"){i=i+1;o.run_id=argv[i];}i=i+1;
  }
  assert(!o.live||action=="down"||action=="status"||getenv("LMWEBLAB_REMAINING_LIVE_GO","")=="1","Live runs await the Lead go after scenarios 03–06");
  assert(!o.live||getenv("AWS_PROFILE","")=="lmaws","live profile must be lmaws");
  assert(!o.live||getenv("LMAWS_ENDPOINT","")=="","live must not use a fake transport");
  assert(!o.live||o.run_id!="cafe"+number,"live runs require a fresh explicit --run-id");
  assert(o.prefix=="lmaws"&&o.region=="us-east-1","lmaws/us-east-1 scope required");assert(regex_test(o.run_id,"^[0-9a-f]{4,24}$"),"run id must be 4..24 hex digits");assert(num(o.cap)>0&&num(o.cap)<=0.10,"cap must be at most $0.10");
  mkdir(".lmweblab-local");let settings=".lmweblab-local/config.json";write_file(settings,json_stringify(o));
  let args=[o.live?"--live":"--offline","--config",settings];let start=now();
  if((action=="up"||action=="test")&&!contains(argv,"--phase-child")) {
    let child=system(concat(["lmctl",action+".lms"],concat(args,["--phase-child"])),o.live?2400000:300000);
    write_file(".lmweblab-local/"+action+"-child.log",child.stdout+child.stderr);
    if(child.code!=0){let down=system(concat(["lmctl","down.lms"],args),o.live?1800000:240000);assert(down.code==0,"phase failed and cleanup incomplete");assert(false,"phase failed; cleanup attempted; inspect private log");}
  }else if(action=="all") {
    let up=system(concat(["lmctl","up.lms"],args),o.live?1800000:240000);let tested={code:1,stdout:"",stderr:""};if(up.code==0){tested=system(concat(["lmctl","test.lms"],args),o.live?2400000:300000);}
    let down=system(concat(["lmctl","down.lms"],args),o.live?1800000:240000);write_file(".lmweblab-local/all.log",up.stdout+up.stderr+tested.stdout+tested.stderr+down.stdout+down.stderr);
    assert(down.code==0,"teardown incomplete; inspect private all.log");assert(up.code==0&&tested.code==0,"scenario failed; teardown attempted; inspect private all.log");
  }else if(action=="up"){rw_up(o);}
  else if(action=="test") {
    assert(file_exists(".lmweblab-local/state.json"),"run up first");
    o.url=get(json_parse(read_file(".lmweblab-local/state.json")),"lambda_url","");
    if(number=="10"){o.cf_url="";if(o.live){o.cf_url="https://"+json_parse(read_file(".lmweblab-local/web-"+o.run_id+".json")).cf_domain;}rw_upload_test(o);}else if(o.live){rw_live_test(o);}else{rw_fixture_test(o);}
    rw_step(o,"record_http",{requests:100,bytes:2097152});let report=system(["lmctl","report.lms"],120000);assert(report.code==0,"picture report failed");
  }else if(action=="down"){rw_down(o);}
  else {
    let state=".lmweblab-local/serverless-"+o.run_id+".json";
    let p=_dsl_ cli="lmaws" install="github:lmctl-ai/lmaws@latest";
let c=aws.region(${o.region});if(${!o.live}){c=c.demo();}let run=c.serverless_stack(${o.run_id},${o.domain},${state});file_write(".lmweblab-local/status.json",run.status().json());
end _dsl_
    rw_exec(p,o,"status",120000);
  }
  write_file(".lmweblab-local/"+action+"-receipt.json",json_stringify({scenario:number,synthetic:!o.live,passed:true,elapsed_ms:now()-start}));println("PASS "+(o.live?"live":"synthetic")+" scenario "+number+" "+action);
  let cost="0.0000";if(o.live){let summary=".lmweblab-local/state.json";if(action=="down"||action=="all"){summary=".lmweblab-local/down.json";}if(file_exists(summary)){cost=get(json_parse(read_file(summary)),"estimated_cost_usd",cost);}if(number=="10"&&file_exists(".lmweblab-local/web-"+o.run_id+".json")){cost=str(num(cost)+num(get(json_parse(read_file(".lmweblab-local/web-"+o.run_id+".json")),"total_estimated_usd","0")));}}println("estimated cost: $"+cost);
}
