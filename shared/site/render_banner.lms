# Renders shared/site/banner.png (640x240) illustrating the lmweblab stack.
mkdir("images");
mkdir("shared/site");
mkdir(".lmweblab-local");

p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(640, 240, "#0f172a");
scene.text(24.0, 34.0, 18.0, "lmweblab: Route 53 + CloudFront OAC + S3 + EC2 Spot", "#e2e8f0").set_attr("font-weight", "700");
scene.text(24.0, 56.0, 12.0, "Tagged lmaws_test=<run_id> across all resources", "#94a3b8");

let r53 = scene.box(90.0, 145.0, 120.0, 56.0, "Route 53\nlmaws-*", "#1e293b", "#38bdf8", 8.0, 12.0);
let cf = scene.box(265.0, 110.0, 130.0, 52.0, "CloudFront\n+ OAC", "#1e293b", "#818cf8", 8.0, 12.0);
let s3 = scene.cylinder(465.0, 110.0, 120.0, 64.0, "Private S3\nlmaws-*", "#1e293b", "#34d399", 12.0);
let ec2 = scene.box(265.0, 185.0, 130.0, 48.0, "EC2 Spot Nano\nDynamic HTTP", "#1e293b", "#fbbf24", 8.0, 12.0);
let curl = scene.box(465.0, 185.0, 120.0, 48.0, "lmcurl\nContract Suite", "#1e293b", "#f472b6", 8.0, 12.0);

scene.connector(r53, "e", cf, "w", "elbow", "none", "arrow", "none", "#38bdf8", 2.0, "", 0.5, 0.0, 0.0);
scene.connector(cf, "e", s3, "w", "straight", "none", "arrow", "none", "#34d399", 2.0, "", 0.5, 0.0, 0.0);
scene.connector(r53, "e", ec2, "w", "elbow", "none", "arrow", "none", "#fbbf24", 2.0, "", 0.5, 0.0, 0.0);
scene.connector(curl, "w", ec2, "e", "straight", "none", "arrow", "none", "#f472b6", 2.0, "", 0.5, 0.0, 0.0);

scene.render_png("images/banner.png", 640, 240, 1);
end _dsl_

out = ".lmweblab-local/render_banner.dslb";
savedsl(p, out);
r = system(concat(dsl_cli(p), ["--lmcode", out]), 60000);
if (r.code != 0) {
  println(r.stderr);
}
assert(r.code == 0);
assert(copy_file("images/banner.png", "shared/site/banner.png"));
println("wrote shared/site/banner.png");
