# Synthetic latency picture for the lmweblab README/report. No live host data.
mkdir("images");mkdir("shared/site");mkdir(".lmweblab-local");
p = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(720, 360, "#0f172a");
scene.text(28.0, 34.0, 20.0, "lmweblab HTTP contract (synthetic)", "#e2e8f0").set_attr("font-weight", "700");
scene.text(28.0, 58.0, 12.0, "Example p95 latency in milliseconds; live evidence stays private", "#94a3b8");
scene.text(28.0,118.0,13.0,"DNS","#cbd5e1");scene.box(300.0,96.0,99.0,30.0,"18 ms","#38bdf8","#38bdf8",5.0,10.0);
scene.text(28.0,176.0,13.0,"CloudFront","#cbd5e1");scene.box(300.0,154.0,231.0,30.0,"42 ms","#818cf8","#818cf8",5.0,10.0);
scene.text(28.0,234.0,13.0,"EC2 app","#cbd5e1");scene.box(300.0,212.0,418.0,30.0,"76 ms","#fbbf24","#fbbf24",5.0,10.0);
scene.text(28.0,292.0,13.0,"API JSON","#cbd5e1");scene.box(300.0,270.0,335.0,30.0,"61 ms","#34d399","#34d399",5.0,10.0);
scene.text(28.0,336.0,11.0,"Synthetic fixture only — no account IDs, hostnames, or addresses", "#94a3b8");
scene.render_png("images/lmweblab_latency.png", 720, 360, 1);
end _dsl_
out=".lmweblab-local/render_latency.dslb";savedsl(p,out);
r=system ${dsl_cli(p)} --lmcode .lmweblab-local/render_latency.dslb;
if(r.code!=0){println(r.stdout);println(r.stderr);}
assert(r.code==0);assert(copy_file("images/lmweblab_latency.png","shared/site/lmweblab_latency.png"));
println("wrote shared/site/lmweblab_latency.png");
